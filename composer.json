{
  "name": "immediate/health-check-bundle",
  "description": "Health Check bundle for Immediate applications and services",
  "type": "symfony-bundle",
  "license": "Proprietary",
  "authors": [
    {
      "name": "Michael Smith",
      "email": "michael.smith@immediate.co.uk"
    }
  ],
  "require": {
    "php": "^8.5",
    "nelmio/api-doc-bundle": "^5.9",
    "symfony/yaml": "^7.4 || ^8.0"
  },
  "require-dev": {
    "doctrine/doctrine-bundle": "^2.10",
    "doctrine/mongodb-odm-bundle": "^4.5 || ^5.5",
    "immediate/symfony-test-config": "dev-feature/abstract-test-case-helpers",
    "oomphinc/composer-installers-extender": "^2.0",
    "symfony/dependency-injection": "^7.4 || ^8.0"
  },
  "autoload": {
    "psr-4": {
      "IM\\Fabric\\Bundle\\HealthCheckBundle\\": "src/"
    },
    "exclude-from-classmap": [
      "/tests/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "IM\\Fabric\\Bundle\\HealthCheckBundle\\Tests\\": [
        "tests/",
        "tests/phpunit/"
      ],
      "IM\\Fabric\\Package\\SymfonyTestConfig\\": "test-config/src/"
    }
  },
  "repositories": [
    {
      "type": "git",
      "url": "https://github.com/immediatemediaco/symfony-test-config.git"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "oomphinc/composer-installers-extender": true
    }
  },
  "extra": {
    "installer-types": [
      "test-config"
    ],
    "installer-paths": {
      "test-config/": [
        "immediate/symfony-test-config"
      ]
    }
  },
  "scripts": {
    "apply-phpcbf": "test-config/run-tests.sh --apply-phpcbf",
    "apply-rector": "test-config/run-tests.sh --apply-rector",
    "check-coverage": "test-config/run-tests.sh --check-coverage",
    "check-recipes": "test-config/run-tests.sh --check-recipes",
    "run-phpcs": "test-config/run-tests.sh --phpcs",
    "run-phplint": "test-config/run-tests.sh --phplint",
    "run-phpmd": "test-config/run-tests.sh --phpmd",
    "run-phpstan": "test-config/run-tests.sh --phpstan",
    "run-phpunit": "test-config/run-tests.sh --phpunit",
    "run-rector": "test-config/run-tests.sh --rector",
    "run-tests": "rm -rf tests/cache && test-config/run-tests.sh --phpcs --phplint --phpmd --phpunit --rector"
  }
}
